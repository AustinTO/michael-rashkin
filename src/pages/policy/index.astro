---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

import { sanityFetch } from '../../lib/sanity';
import { Q } from '../../lib/queries';
import { getContentPage } from '../../lib/cmsPage';
import type { ContentCardItem } from '../../lib/types';

const { page, html } = await getContentPage('/policy');
const items = await sanityFetch<ContentCardItem[]>(Q.allPolicyNotes).catch(() => []);
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="container" style="padding-top: 38px;">
    <div class="prose">{html ? <div set:html={html} /> : null}</div>

    <div class="grid grid-3" style="margin-top: 14px;">
      {items.map((item) => (
        <ContentCard href={`/policy/${item.slug}`} title={item.title} contentType={item.contentType} date={item.date} excerpt={item.excerpt} />
      ))}
    </div>
  </section>
</BaseLayout>
