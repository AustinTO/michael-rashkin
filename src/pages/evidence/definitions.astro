---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Definitions — Michael Rashkin" description="Glossary of research and statistics terms.">
  <section class="container" style="padding-top: 38px;">
    <div class="prose">
      <h1>Definitions</h1>
      <p class="muted">A simple glossary to reduce confusion.</p>

      <ul>
        <li>Absolute vs relative risk</li>
        <li>Confounding</li>
        <li>Selection bias</li>
        <li>External validity</li>
        <li>NNT / NNH</li>
        <li>Correlation vs causation</li>
        <li>Surrogate endpoints</li>
        <li>Publication bias</li>
        <li>Dose-response</li>
        <li>Intent-to-treat</li>
      </ul>

      <p class="muted small">Fill these in over time.</p>
    </div>
  </section>
</BaseLayout>
