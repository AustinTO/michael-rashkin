---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContentPage } from '../../lib/cmsPage';

const { page, html } = await getContentPage('/evidence/editorial-policy', Astro.request);
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="container" style="padding-top: 38px;">
    <div class="prose">{html ? <div set:html={html} /> : null}</div>
  </section>
</BaseLayout>
