---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Reference library — Michael Rashkin" description="Reference library is being built.">
  <section class="container" style="padding-top: 38px;">
    <div class="prose">
      <h1>Reference library</h1>
      <p>
        Reference library is being built. For now, references are listed on each topic and episode page.
      </p>

      <div class="card" style="margin-top: 14px;">
        <p class="muted" style="margin:0;">
          You can implement this later using the <span class="kbd">referenceEntry</span> schema.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
