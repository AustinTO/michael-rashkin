---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContentPage } from '../lib/cmsPage';
import { urlFor } from '../lib/image';
import { portableTextToHtml } from '../lib/portableText';
import { sanityFetch } from '../lib/sanity';
import { Q } from '../lib/queries';
import type { SiteSettings } from '../lib/types';

const { page, html } = await getContentPage('/about', Astro.request);
const settings = await sanityFetch<SiteSettings | null>(Q.siteSettings, {}, { request: Astro.request }).catch(() => null);
const heroImageUrl = page.heroImage ? urlFor(page.heroImage).width(1200).height(1400).fit('crop').quality(84).format('webp').url() : null;
const blocks = Array.isArray(page.body) ? page.body : [];
const introBlockCount = getIntroBlockCount(blocks, 5);
const introHtml = portableTextToHtml(blocks.slice(0, introBlockCount));
const restHtml = portableTextToHtml(blocks.slice(introBlockCount));

function getIntroBlockCount(value: any[], maxParagraphs: number): number {
  let paragraphCount = 0;

  for (let i = 0; i < value.length; i += 1) {
    const block = value[i];
    if (block?._type !== 'block') {
      return i === 0 ? 1 : i;
    }

    if (block.style === 'normal' || !block.style) {
      paragraphCount += 1;
    }

    if (paragraphCount >= maxParagraphs) {
      return i + 1;
    }
  }

  return value.length;
}
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="container about-shell">
    <div class="about-intro">
      {heroImageUrl ? (
        <div class="about-media">
          <img
            src={heroImageUrl}
            alt={page.heroImageAlt || page.title}
            loading="eager"
            class="about-hero"
          />
          {settings?.credentialsLine ? <p class="about-credentials">{settings.credentialsLine}</p> : null}
        </div>
      ) : null}

      <div class="about-copy">
        <div class="about-heading">
          <h1>{page.title}</h1>
        </div>
        {introHtml ? <div set:html={introHtml} /> : null}
      </div>
    </div>

    {restHtml ? (
      <div class="article-prose about-rest" set:html={restHtml} />
    ) : (!introHtml && html ? <div class="article-prose about-rest" set:html={html} /> : null)}
  </section>
</BaseLayout>

<style>
  .about-shell {
    padding-top: 40px;
    padding-bottom: 10px;
  }

  .about-intro {
    display: grid;
    grid-template-columns: 280px minmax(0, 620px);
    align-items: start;
    justify-content: center;
    gap: 40px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .about-media {
    width: 280px;
  }

  .about-hero {
    width: 100%;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    box-shadow: var(--depth-2);
    background: var(--surface-2);
  }

  .about-credentials {
    margin: 12px 6px 0;
    font-family: "Inter Tight", "Avenir Next", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 0.84rem;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  .about-copy {
    max-width: 620px;
    padding-top: 14px;
  }

  .about-heading {
    margin-bottom: 22px;
  }

  .about-heading h1 {
    margin: 0;
    font-size: clamp(2.1rem, 1.85rem + 0.8vw, 2.8rem);
    line-height: 1.04;
    max-width: 11ch;
  }

  .about-copy :global(p) {
    font-size: clamp(1.08rem, 1.02rem + 0.18vw, 1.16rem);
    line-height: 1.78;
    color: color-mix(in srgb, var(--text) 92%, var(--text-secondary));
  }

  .about-copy :global(p:first-child) {
    font-size: clamp(1.22rem, 1.12rem + 0.35vw, 1.42rem);
    line-height: 1.58;
    color: var(--text);
  }

  .about-copy :global(strong),
  .about-copy :global(b) {
    color: var(--text);
    font-weight: 720;
  }

  .about-copy :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1.3px;
    text-underline-offset: 0.14em;
  }

  .about-rest {
    max-width: var(--article-content);
    margin: 52px auto 0;
    padding-top: 32px;
    border-top: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
  }

  @media (max-width: 900px) {
    .about-intro {
      display: block;
      max-width: var(--article-content);
    }

    .about-media {
      margin-bottom: 24px;
    }

    .about-hero {
      max-width: 420px;
    }

    .about-copy {
      padding-top: 0;
    }

    .about-heading h1 {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .about-shell {
      padding-top: 30px;
    }

    .about-hero {
      max-width: 100%;
    }

    .about-rest {
      max-width: var(--article-content);
      margin-top: 28px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
