---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

import { sanityFetch } from '../../lib/sanity';
import { Q } from '../../lib/queries';
import { getContentPage } from '../../lib/cmsPage';
import { getVideoThumbnailFromEmbedUrl } from '../../lib/videoThumbnail';
import type { ContentCardItem } from '../../lib/types';

const { page, html } = await getContentPage('/media', Astro.request);
const items = await sanityFetch<ContentCardItem[]>(Q.allMedia, {}, { request: Astro.request }).catch(() => []);
const cardFallbackImageUrl = (item: ContentCardItem): string | undefined => {
  if (item.heroImage || item._type !== 'mediaEpisode') return undefined;
  return getVideoThumbnailFromEmbedUrl(item.embedUrl) || undefined;
};
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="container" style="padding-top: 38px;">
    <div class="prose">{html ? <div set:html={html} /> : null}</div>

    <div class="grid grid-3" style="margin-top: 14px;">
      {items.map((item) => (
        <ContentCard
          href={`/media/${item.slug}`}
          title={item.title}
          contentType={item.contentType}
          date={item.date}
          excerpt={item.excerpt}
          image={item.heroImage}
          imageAlt={item.heroImageAlt}
          imageUrl={cardFallbackImageUrl(item)}
        />
      ))}
    </div>
  </section>
</BaseLayout>
