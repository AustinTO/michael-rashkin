---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLegalPage } from '../lib/cmsPage';

const { page, html } = await getLegalPage('disclaimer', Astro.request);
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.title}>
  <section class="container" style="padding-top: 38px;">
    <div class="prose">{html ? <div set:html={html} /> : null}</div>
  </section>
</BaseLayout>
