---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ContentCard from '../components/ContentCard.astro';
import TopicTile from '../components/TopicTile.astro';
import Button from '../components/Button.astro';

import { sanityFetch } from '../lib/sanity';
import { Q } from '../lib/queries';
import { getContentPage } from '../lib/cmsPage';
import { urlFor } from '../lib/image';
import type { ContentCardItem, SiteSettings, Topic } from '../lib/types';

const { page, html } = await getContentPage('/');
const settings = await sanityFetch<SiteSettings | null>(Q.siteSettings).catch(() => null);

const latest = await sanityFetch<ContentCardItem[]>(Q.latestContent).catch(() => []);
const media = latest.filter((i) => i._type === 'mediaEpisode').slice(0, 2);
const insights = latest.filter((i) => i._type === 'insight').slice(0, 3);
const policy = latest.filter((i) => i._type === 'policyNote').slice(0, 1);
const latestSix = [...media, ...insights, ...policy].slice(0, 6);

const featuredTopics: Topic[] = settings?.featuredTopics || [];
const pinned = settings?.pinnedContent || [];
const heroActions = settings?.heroActions || [];
const homePillars = settings?.homePillars || [];
const heroImageUrl = page?.heroImage ? urlFor(page.heroImage).width(1600).quality(82).url() : null;
const heroImageAlt = page?.heroImageAlt || page?.title || 'Hero image';
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="hero">
    <div class="hero-shell">
      <div class="hero-bg" aria-hidden="true">
        <video
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/hero-poster.avif"
        >
          <source src="/hero.webm" type="video/webm" />
          <source src="/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-bottom-fade"></div>

      <div class="hero-content container">
        <div class="prose hero-copy reveal">
          {html ? <div set:html={html} /> : null}

          {heroActions.length ? (
            <div class="hero-actions">
              {heroActions.map((action, idx) => (
                <Button href={action.href} variant={idx === 0 ? 'primary' : idx === 1 ? 'ghost' : 'link'}>
                  {action.label}
                </Button>
              ))}
            </div>
          ) : null}

          {settings?.credentialsLine ? (
            <p class="small muted" style="margin-top: 18px;">
              {settings.credentialsLine}
              {settings.credentialsLinkLabel && settings.credentialsLinkHref ? (
                <>
                  {' '}
                  <a class="text-link" href={settings.credentialsLinkHref}>{settings.credentialsLinkLabel}</a>
                </>
              ) : null}
            </p>
          ) : null}
        </div>
        {heroImageUrl ? (
          <div class="hero-image-wrap reveal">
            <img
              src={heroImageUrl}
              alt={heroImageAlt}
              loading="lazy"
              class="hero-image"
            />
          </div>
        ) : null}
        <div class="hero-divider" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  {homePillars.length ? (
    <Section divider={true}>
      <div class="grid grid-3 stagger">
        {homePillars.map((pillar) => (
          <div class="card card-panel reveal">
            <h3 style="margin-top:0;">{pillar.title}</h3>
            {pillar.description ? <p class="muted" style="margin-bottom:0;">{pillar.description}</p> : null}
            {pillar.buttonLabel && pillar.buttonHref ? (
              <div style="margin-top: 12px;"><a class="text-link" href={pillar.buttonHref}>→ {pillar.buttonLabel}</a></div>
            ) : null}
          </div>
        ))}
      </div>
    </Section>
  ) : null}

  <Section title={settings?.featuredTopicsHeading || 'Featured Topics'} label={settings?.featuredTopicsHeading || 'Featured Topics'} divider={true}>
    <div class="grid grid-3 featured-grid stagger" style="margin-top: 14px;">
      {featuredTopics.map((t) => (
        <TopicTile href={`/topics/${t.slug}`} title={t.title} description={t.intro} updatedAt={t.updatedAt} />
      ))}
    </div>
  </Section>

  <Section title={settings?.latestHeading || 'Latest'} label={settings?.latestHeading || 'Latest'} divider={true}>
    <div class="grid grid-3 stagger" style="margin-top: 14px;">
      {latestSix.map((item) => (
        <ContentCard
          href={item._type === 'mediaEpisode' ? `/media/${item.slug}` : item._type === 'policyNote' ? `/policy/${item.slug}` : `/insights/${item.slug}`}
          title={item.title}
          contentType={item.contentType}
          date={item.date}
          excerpt={item.excerpt}
        />
      ))}
    </div>
  </Section>

  <Section title={settings?.mostReadHeading || 'Most read'} label={settings?.mostReadHeading || 'Most read'} divider={true}>
    <div class="grid grid-3 stagger" style="margin-top: 14px;">
      {pinned.map((item) => (
        <ContentCard
          href={item._type === 'mediaEpisode' ? `/media/${item.slug}` : item._type === 'policyNote' ? `/policy/${item.slug}` : `/insights/${item.slug}`}
          title={item.title}
          contentType={item.contentType}
          date={item.date}
          excerpt={item.excerpt}
        />
      ))}
    </div>
  </Section>
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector('.hero');
  const heroShell = document.querySelector('.hero-shell');

  let clipRaf = 0;
  const updateHeroClose = () => {
    if (!(hero instanceof HTMLElement) || !(heroShell instanceof HTMLElement)) return;
    const rect = hero.getBoundingClientRect();
    const progressed = Math.max(0, -rect.top);
    const distance = Math.max(1, heroShell.offsetHeight * 1.1);
    const closePct = Math.min(100, (progressed / distance) * 100);
    heroShell.style.clipPath = `inset(0 0 ${closePct.toFixed(3)}% 0)`;
  };

  const onClipScroll = () => {
    if (clipRaf) return;
    clipRaf = requestAnimationFrame(() => {
      updateHeroClose();
      clipRaf = 0;
    });
  };

  const applyMotionPreference = () => {
    document.querySelectorAll('.hero-video').forEach((node) => {
      if (!(node instanceof HTMLVideoElement)) return;
      if (reducedMotion.matches) {
        node.pause();
        node.removeAttribute('autoplay');
        node.removeAttribute('loop');
        node.currentTime = 0;
        node.load();
      }
    });
  };
  applyMotionPreference();
  reducedMotion.addEventListener?.('change', applyMotionPreference);
  window.addEventListener('scroll', onClipScroll, { passive: true });
  window.addEventListener('resize', onClipScroll, { passive: true });
  onClipScroll();
</script>

<style>
.hero {
  --hero-runway: 2vh;
  padding-top: 0;
  padding-bottom: 0;
  margin-bottom: 0;
  min-height: calc(clamp(400px, 52vh, 640px) + var(--hero-runway));
}
.hero-shell {
  position: relative;
  position: sticky;
  top: 80px;
  overflow: hidden;
  min-height: clamp(400px, 52vh, 640px);
  background: var(--surface-2);
  will-change: clip-path;
}
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
.hero-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.34;
  filter: blur(1px);
  -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.94) 30%,
      rgba(0, 0, 0, 1) 46%,
      rgba(0, 0, 0, 1) 100%
    ),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 1) 66%,
      rgba(0, 0, 0, 0.95) 82%,
      transparent 100%
    );
  -webkit-mask-composite: source-in;
  mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.94) 30%,
      rgba(0, 0, 0, 1) 46%,
      rgba(0, 0, 0, 1) 100%
    ),
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 1) 66%,
      rgba(0, 0, 0, 0.95) 82%,
      transparent 100%
    );
  mask-composite: intersect;
}
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(var(--overlay-tint), var(--overlay-heavy)),
      linear-gradient(
        to right,
        var(--overlay-heavy) 0%,
        color-mix(in srgb, var(--overlay-heavy) 92%, transparent) 34%,
        color-mix(in srgb, var(--overlay-tint) 68%, transparent) 56%,
        transparent 90%
      );
  }
  .hero-bottom-fade {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 64%,
      color-mix(in srgb, var(--hero-fade) 60%, transparent) 84%,
      var(--hero-fade) 100%
    );
  }
  .hero-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        var(--overlay-heavy) 0%,
        color-mix(in srgb, var(--overlay-heavy) 86%, transparent) 18%,
        color-mix(in srgb, var(--overlay-tint) 54%, transparent) 30%,
        transparent 44%
      ),
      linear-gradient(
        to bottom,
        transparent 0%,
        transparent 68%,
        color-mix(in srgb, var(--hero-fade) 44%, transparent) 88%,
        color-mix(in srgb, var(--hero-fade) 82%, transparent) 100%
      );
  }
  .hero-content {
    position: relative;
    z-index: 4;
    padding-top: 0;
    padding-bottom: 0;
  }
  .hero-copy {
    max-width: 920px;
    position: relative;
    isolation: isolate;
  }
  .hero-copy::before {
    content: "";
    position: absolute;
    inset: -16px -20px;
    z-index: -1;
    pointer-events: none;
    opacity: 0.045;
    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--accent) 22%, transparent) 1px,
      transparent 1px
    );
    background-size: 100% 48px;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.92) 14%,
      rgba(0, 0, 0, 0.92) 86%,
      transparent 100%
    );
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .hero-image-wrap {
    margin-top: 28px;
    position: relative;
    z-index: 2;
  }
  .hero-image {
    width: 100%;
    max-width: 1040px;
    height: auto;
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: none;
  }
  .hero-divider {
    margin-top: 56px;
    height: 1px;
    width: min(1040px, 100%);
    background: linear-gradient(90deg, transparent 0%, var(--accent-glow) 50%, transparent 100%);
    position: relative;
    z-index: 2;
  }
  .featured-grid > *:first-child {
    grid-column: span 2;
      box-shadow: var(--depth-2);
  }
  @media (hover: hover) and (pointer: fine) {
    .featured-grid > *:first-child:hover {
      box-shadow: var(--depth-3);
    }
  }
  @media (max-width: 960px) {
    .hero {
      --hero-runway: 2vh;
      padding-top: 0;
      margin-bottom: 0;
      min-height: calc(clamp(345px, 56vh, 560px) + var(--hero-runway));
    }
    .hero-shell {
      top: 72px;
      min-height: clamp(345px, 56vh, 560px);
    }
    .hero-video {
      opacity: 0.56;
      filter: blur(0.8px);
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero-overlay {
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--overlay-heavy) 72%, transparent) 0%,
        color-mix(in srgb, var(--overlay-tint) 44%, transparent) 42%,
        color-mix(in srgb, var(--overlay-tint) 24%, transparent) 72%,
        transparent 100%
      );
    }
    .hero-shell::before {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        transparent 72%,
        color-mix(in srgb, var(--hero-fade) 52%, transparent) 88%,
        var(--hero-fade) 100%
      );
    }
    .hero-bottom-fade {
      background: linear-gradient(
        to bottom,
        transparent 0%,
        transparent 74%,
        color-mix(in srgb, var(--hero-fade) 52%, transparent) 90%,
        color-mix(in srgb, var(--hero-fade) 86%, transparent) 100%
      );
    }
    .featured-grid > *:first-child {
      grid-column: span 1;
    }
  }

.hero + .container.section-rule {
  margin-top: var(--space-3);
}
  .hero + .container.section-rule .section-divider {
    display: block;
  }
</style>
