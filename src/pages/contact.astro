---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getContentPage } from '../lib/cmsPage';

const { page, html } = await getContentPage('/contact', Astro.request);
---
<BaseLayout title={`${page.title} — Michael Rashkin`} description={page.description || page.title}>
  <section class="container" style="padding-top: 38px;">
    <div class="prose">{html ? <div set:html={html} /> : null}</div>
    <div style="margin-top: 18px; max-width: var(--content);">
      <ContactForm />
    </div>
  </section>
</BaseLayout>
