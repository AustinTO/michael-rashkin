---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleShell from '../../components/ArticleShell.astro';
import SourcesList from '../../components/SourcesList.astro';
import ContentCard from '../../components/ContentCard.astro';

import { sanityFetch } from '../../lib/sanity';
import { Q } from '../../lib/queries';
import { portableTextToHtml } from '../../lib/portableText';
import { urlFor } from '../../lib/image';
import type { ContentCardItem, Insight } from '../../lib/types';

export async function getStaticPaths() {
  const items = await sanityFetch<Array<{ slug: string }>>(Q.allInsights).catch(() => []);
  return items.map((i) => ({ params: { slug: i.slug } }));
}

const { slug } = Astro.params;
const post = await sanityFetch<Insight | null>(Q.insightBySlug, { slug }, { request: Astro.request });

if (!post) {
  Astro.response.status = 404;
}

const html = post ? portableTextToHtml(post.body) : '';
const date = post ? (post.updatedAt || post.publishedAt) : undefined;
const heroImageUrl = post?.heroImage ? urlFor(post.heroImage).width(1600).height(900).fit('crop').quality(82).format('webp').url() : null;
const evidenceTier = !post
  ? ''
  : post.contentType === 'Evidence Brief'
    ? 'Tier 1 dominant'
    : post.contentType === 'Deep Dive'
      ? 'Tier 2 dominant'
      : post.contentType === 'Myth Check'
        ? 'Tier 2-3 mixed'
        : 'Interpretive';

const relatedRaw = post?.primaryTopic?._id
  ? await sanityFetch<ContentCardItem[]>(Q.relatedByTopicId, { topicId: post.primaryTopic._id }, { request: Astro.request }).catch(() => [])
  : [];

const related = post ? relatedRaw.filter((i) => i._id !== post._id).slice(0, 6) : [];
---
<BaseLayout title={`${post?.title || 'Insight not found'} — Michael Rashkin`} description={post?.summaryBullets?.[0] || post?.title || 'Insight not found'}>
  {!post ? (
    <section class="container">
      <h1>Insight not found</h1>
      <p class="muted">This draft or page may not be available in the current perspective.</p>
    </section>
  ) : (
  <>
  <section class="container">
    <ArticleShell
      title={post.title}
      description={post.summaryBullets?.[0]}
      meta={[
        { label: 'Updated', value: date ? new Date(date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : 'Not set' },
        { label: 'Evidence tier', value: evidenceTier }
      ]}
      corrections={date ? [`${new Date(date).toISOString().slice(0, 10)}: Last content update published.`] : []}
    >
      {heroImageUrl ? (
        <img
          src={heroImageUrl}
          alt={post.title}
          loading="eager"
          class="insight-hero"
        />
      ) : null}
      {post.summaryBullets?.length ? (
        <ul>
          {post.summaryBullets.map((b) => (<li>{b}</li>))}
        </ul>
      ) : null}
      {html ? <div class="prose" set:html={html} /> : <p class="muted">Add body content in Sanity.</p>}
      <div style="margin-top: 24px;">
        <SourcesList sources={post.sources} />
      </div>
    </ArticleShell>
  </section>

  {related.length ? (
    <section class="container section-rule">
      <h2 style="margin:0;">Related content</h2>
      <div class="grid grid-3" style="margin-top: 14px;">
        {related.map((item) => (
          <ContentCard
            href={item._type === 'mediaEpisode' ? `/media/${item.slug}` : item._type === 'policyNote' ? `/policy/${item.slug}` : `/insights/${item.slug}`}
            title={item.title}
            contentType={item.contentType}
            date={item.date}
            excerpt={item.excerpt}
            image={item.heroImage}
            imageAlt={item.heroImageAlt}
          />
        ))}
      </div>
    </section>
  ) : null}
  </>
  )}
</BaseLayout>

<style>
  .insight-hero {
    width: 100%;
    max-width: var(--content);
    display: block;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    margin: 0 0 18px;
    object-fit: cover;
  }
</style>
