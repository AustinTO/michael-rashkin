---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';
import '../styles/global.css';

const {
  title = 'Michael Rashkin',
  description = 'Evidence-forward analysis on nutrition and population health. Opinions clearly labeled. Sources included. Corrections public.',
  canonicalPath = Astro.url.pathname,
  noindex = false
} = Astro.props;

const site = (process.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(/\/$/, '');
const canonical = `${site}${canonicalPath}`;
const visualEditingConfigured =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true' || import.meta.env.DEV;
const secFetchDest = Astro.request.headers.get('sec-fetch-dest');
const referer = Astro.request.headers.get('referer') || '';
const isPresentationRequest = secFetchDest === 'iframe' || /\/studio(\/|$)/i.test(referer);
const visualEditingEnabled = visualEditingConfigured && isPresentationRequest;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : null}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
  </body>
</html>
