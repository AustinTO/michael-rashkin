---
import Divider from './Divider.astro';
import SectionHeader from './SectionHeader.astro';

const { title, label, divider = true, accent = false } = Astro.props;
---
<section class:list={['container', divider && 'section-rule']}>
  {divider ? <Divider /> : null}
  <SectionHeader title={title} label={label} accent={accent} />
  <slot />
</section>
