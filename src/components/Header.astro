---
const pathname = Astro.url.pathname;
const nav = [
  { label: 'Topics', href: '/topics' },
  { label: 'Evidence', href: '/evidence' },
  { label: 'Media', href: '/media' },
  { label: 'About', href: '/about' }
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Michael Rashkin</a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          class:list={['nav-link', pathname.startsWith(item.href) && 'is-active']}
          href={item.href}
          aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme" aria-pressed="false">
      <span class="theme-icon sun" aria-hidden="true">☼</span>
      <span class="theme-icon moon" aria-hidden="true">◐</span>
      <span class="theme-knob" aria-hidden="true"></span>
    </button>
    <a class="btn btn-primary header-cta" href="/newsletter">Newsletter</a>
    <details class="mobile-menu">
      <summary class="mobile-menu-btn">Menu</summary>
      <div class="mobile-menu-panel">
        {nav.map((item) => (
          <a
            class:list={['mobile-link', pathname.startsWith(item.href) && 'is-active']}
            href={item.href}
            aria-current={pathname.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
        <a class="mobile-link mobile-newsletter" href="/newsletter">Newsletter</a>
      </div>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 6);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const mobileMenu = document.querySelector('.mobile-menu');
  if (mobileMenu instanceof HTMLDetailsElement) {
    const closeMenu = () => {
      mobileMenu.open = false;
    };
    document.addEventListener('click', (event) => {
      if (!mobileMenu.open) return;
      const target = event.target;
      if (target instanceof Node && !mobileMenu.contains(target)) {
        closeMenu();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
  }

  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  if (toggle instanceof HTMLButtonElement) {
    const sync = () => {
      const dark = root.classList.contains('dark');
      toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
    };
    sync();
    toggle.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
      sync();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg-main) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg-main) 96%, transparent);
    border-bottom-color: var(--border);
    box-shadow: var(--depth-1);
  }
  .header-inner {
    min-height: 80px;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    font-family: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }
  .nav {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-left: auto;
    justify-content: flex-end;
  }
  .nav-link {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    position: relative;
    padding: 8px 10px;
    border-radius: 10px;
    transition: color 200ms ease, background-color 200ms ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 5px;
    height: 2px;
    transform-origin: left;
    transform: scaleX(0);
    background: var(--accent);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover {
    color: var(--text-primary);
    background: var(--surface-1);
  }
  .nav-link.is-active {
    color: var(--text-primary);
  }
  .nav-link.is-active::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .header-cta {
    margin-left: 10px;
    padding-inline: 14px;
    font-size: 0.84rem;
    min-height: 38px;
    font-weight: 610;
  }
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-left: 10px;
    width: 66px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-muted);
    padding: 0 10px;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .theme-icon {
    font-size: 0.72rem;
    line-height: 1;
    z-index: 1;
  }
  .theme-knob {
    position: absolute;
    width: 24px;
    height: 24px;
    left: 4px;
    top: 4px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: var(--depth-1);
    transition: transform 150ms ease, background-color 150ms ease;
  }
  .theme-toggle[aria-pressed="true"] .theme-knob {
    transform: translateX(32px);
  }
  .theme-toggle[aria-pressed="true"] {
    color: color-mix(in srgb, var(--text-primary) 84%, var(--text-secondary));
  }
  .mobile-menu { display: none; }
  .mobile-menu-btn { list-style: none; }
  .mobile-menu-btn::-webkit-details-marker { display: none; }
  @media (max-width: 760px) {
    .header-inner { min-height: 72px; gap: 14px; }
    .nav { display: none; }
    .header-cta { display: none; }
    .theme-toggle {
      margin-left: auto;
    }
    .mobile-menu {
      display: block;
      margin-left: 10px;
      position: relative;
    }
    .mobile-menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 40px;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--text-primary);
      background: var(--surface-1);
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
    }
    .mobile-menu[open] .mobile-menu-btn {
      border-color: var(--border-strong);
      background: var(--surface-2);
    }
    .mobile-menu-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 8px);
      min-width: 180px;
      display: grid;
      gap: 2px;
      padding: 8px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--surface-1);
      box-shadow: 0 18px 36px -24px var(--shadow);
      backdrop-filter: blur(12px);
    }
    .mobile-link {
      color: var(--text-secondary);
      font-size: 0.9rem;
      padding: 8px 10px;
      border-radius: 8px;
      text-decoration: none;
    }
    .mobile-link:hover,
    .mobile-link.is-active {
      color: var(--text-primary);
      background: var(--surface-1);
    }
    .mobile-newsletter {
      margin-top: 4px;
      color: var(--bg-surface);
      background: var(--accent);
      font-weight: 700;
    }
    .mobile-menu-panel {
      background: var(--surface-1);
      box-shadow: 0 16px 30px -24px var(--shadow);
    }
  }
</style>
