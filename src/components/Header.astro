---
const nav = [
  { label: 'Home', href: '/' },
  { label: 'Start Here', href: '/start-here' },
  { label: 'Topics', href: '/topics' },
  { label: 'Evidence', href: '/evidence' },
  { label: 'Media', href: '/media' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' }
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Michael Rashkin</a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a class="nav-link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="cta">
      <a class="button primary" href="/newsletter">Get the newsletter</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .brand {
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .nav {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-left: 10px;
    flex: 1;
    overflow: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar { display: none; }
  .nav-link {
    color: var(--muted);
    font-weight: 600;
    font-size: 14px;
    padding: 8px 6px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--bg-muted);
    text-decoration: none;
    color: var(--text);
  }
  .cta { display: flex; }

  @media (max-width: 880px) {
    .cta { display: none; }
  }
</style>
