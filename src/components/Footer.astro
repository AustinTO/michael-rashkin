---
const trust = [
  { label: 'Disclosure policy', href: '/evidence/disclosures' },
  { label: 'Evidence ranking methodology', href: '/evidence/how-i-evaluate-evidence' },
  { label: 'Corrections log', href: '/evidence/corrections-policy' },
  { label: 'Citation standards', href: '/evidence/reference-library' }
];
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-title">Michael Rashkin</div>
      <p class="muted small" style="max-width: 48ch; margin-top: 8px;">Evidence-first analysis on nutrition and population health.</p>
      <p class="small muted" style="margin-top: 10px;">
        This site is for educational and informational purposes only. It is not medical advice.
      </p>
    </div>

    <div>
      <div class="footer-title">Trust & Methods</div>
      <ul class="footer-list">
        {trust.map((l) => (
          <li><a class="text-link" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="footer-title">Editorial Links</div>
      <ul class="footer-list">
        <li><a class="text-link" href="/topics">Topics</a></li>
        <li><a class="text-link" href="/insights">Insights</a></li>
        <li><a class="text-link" href="/media">Media</a></li>
        <li><a class="text-link" href="/about">About</a></li>
      </ul>
    </div>
  </div>

  <div class="container" style="padding-top: 14px; padding-bottom: 24px;">
    <div class="small muted">© {new Date().getFullYear()} Michael Rashkin. All rights reserved.</div>
    <a class="puphr-credit" href="https://puphr.com" target="_blank" rel="noopener noreferrer">
      <img src="/puphr_logo.svg" alt="Puphr logo" width="14" height="14" loading="lazy" />
      <span>Designed, implemented, and secured by Puphr.</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 112px;
    border-top: 1px solid var(--border);
    background: #070c12;
    box-shadow:
      inset 0 30px 70px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.02);
  }
  .site-footer::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--accent-glow) 50%, transparent 100%);
  }
  .footer-inner {
    padding-top: 40px;
    padding-bottom: 24px;
    display: grid;
    gap: 32px;
    grid-template-columns: 2fr 1fr 1fr;
  }
  .footer-title {
    font-family: "Inter Tight", "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: 0.01em;
    color: var(--text-primary);
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: grid;
    gap: 10px;
  }
  .footer-list a {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }
  .puphr-credit {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
    font-size: 0.74rem;
    line-height: 1.2;
    text-decoration: none;
  }
  .puphr-credit img {
    display: block;
    width: 14px;
    height: 14px;
    opacity: 0.82;
  }
  .puphr-credit:hover {
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
