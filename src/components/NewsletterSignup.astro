---
const { title = 'Get one evidence-based brief per week.', body = 'No spam. Just clear analysis, sources, and updates when I change my mind.' } = Astro.props as {
  title?: string;
  body?: string;
};

function resolveTurnstileSiteKey(value: unknown): string {
  if (typeof value === 'string') return value.trim();
  if (!value || typeof value !== 'object') return '';

  const asRecord = value as Record<string, unknown>;
  const candidate = asRecord.sitekey ?? asRecord.siteKey ?? asRecord.key;
  return typeof candidate === 'string' ? candidate.trim() : '';
}

const turnstileSiteKey = resolveTurnstileSiteKey(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
<section class="card newsletter">
  <div class="header">{title}</div>
  <div class="muted intro">{body}</div>

  <form class="form" method="post" action="/.netlify/functions/subscribe" data-newsletter-form>
    <input class="input" type="email" name="email" placeholder="you@example.com" required />
    {turnstileSiteKey ? (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
    ) : (
      <p class="small muted">Newsletter signup is temporarily unavailable.</p>
    )}
    <button class="button primary" type="submit">Subscribe</button>
  </form>
  <p class="small muted status" data-newsletter-status aria-live="polite"></p>

  <p class="small muted legal">
    By subscribing you agree to receive emails. Unsubscribe anytime.
  </p>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const resetTurnstile = (form) => {
    const widget = form.querySelector('.cf-turnstile');
    if (!(widget instanceof HTMLElement)) return;
    if (typeof window !== 'undefined' && window.turnstile && typeof window.turnstile.reset === 'function') {
      window.turnstile.reset(widget);
    }
  };

  const forms = document.querySelectorAll('[data-newsletter-form]');

  for (const form of forms) {
    const statusEl = form.parentElement?.querySelector('[data-newsletter-status]');
    const submitButton = form.querySelector('button[type="submit"]');
    let inFlight = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (inFlight) return;

      const formData = new FormData(form);
      const emailValue = formData.get('email');
      const tokenValue = formData.get('cf-turnstile-response');
      const email = typeof emailValue === 'string' ? emailValue.trim() : '';
      const token = typeof tokenValue === 'string' ? tokenValue : '';

      if (!email || !token) {
        if (statusEl instanceof HTMLElement) statusEl.textContent = 'Please complete the verification challenge.';
        return;
      }

      inFlight = true;
      if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
      if (statusEl instanceof HTMLElement) statusEl.textContent = 'Submitting...';

      try {
        const response = await fetch('/.netlify/functions/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, token })
        });
        const payload = await response.json().catch(() => ({}));

        if (response.ok) {
          form.reset();
          resetTurnstile(form);
          if (statusEl instanceof HTMLElement) statusEl.textContent = 'Subscribed. Check your inbox for confirmation.';
        } else if (statusEl instanceof HTMLElement) {
          statusEl.textContent =
            typeof payload?.error === 'string'
              ? payload.error
              : 'Unable to subscribe right now. Please try again.';
          resetTurnstile(form);
        }
      } catch {
        if (statusEl instanceof HTMLElement) statusEl.textContent = 'Network error. Please try again.';
        resetTurnstile(form);
      } finally {
        inFlight = false;
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
      }
    });
  }
</script>

<style>
  .newsletter {
    max-width: 780px;
    margin: 0 auto;
    padding: 24px;
    border: 1px solid transparent;
    background: linear-gradient(160deg, color-mix(in srgb, var(--surface-1) 90%, transparent), var(--surface-2));
    border-radius: var(--radius-lg);
    box-shadow: var(--depth-1);
  }
  .header {
    font-weight: 760;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .intro {
    margin-top: 10px;
    max-width: 62ch;
  }
  .form {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 300px auto;
    gap: 10px;
    margin-top: 16px;
    align-items: center;
  }
  .input {
    min-width: 0;
    width: 100%;
    height: 65px;
    padding: 10px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text);
    font-size: 16px;
  }
  .status {
    margin-top: 10px;
    min-height: 1.4em;
  }
  .legal {
    margin-top: 8px;
  }
  .button.primary {
    height: 65px;
    border-radius: 999px;
    white-space: nowrap;
  }
  @media (max-width: 980px) {
    .form {
      grid-template-columns: 1fr;
      align-items: stretch;
    }
    .button.primary {
      width: 100%;
    }
  }
</style>
