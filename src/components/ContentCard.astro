---
import Card from './Card.astro';
import LabelPill from './LabelPill.astro';
import { formatDate } from '../lib/dates';

const {
  href,
  title,
  contentType,
  date,
  excerpt
} = Astro.props as {
  href: string;
  title: string;
  contentType: string;
  date?: string;
  excerpt?: string;
};
---
<Card class="card-link reveal" href={href}>
  <div class="row">
    <LabelPill label={contentType} />
    {date ? <span class="meta-badge">{formatDate(date)}</span> : <span />}
  </div>
  <div class="title">{title}</div>
  {excerpt ? <div class="muted small excerpt">{excerpt}</div> : null}
</Card>

<style>
  .card-link { display: block; color: inherit; }
  .card-link:hover { text-decoration: none; }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .title {
    margin-top: 14px;
    font-size: 1.26rem;
    font-weight: 760;
    line-height: 1.24;
    letter-spacing: -0.015em;
  }
  .excerpt { margin-top: 12px; line-height: 1.66; }
  .meta-badge {
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: var(--surface-1);
    border-radius: 999px;
    font-size: 0.74rem;
    padding: 4px 10px;
    white-space: nowrap;
  }
</style>
