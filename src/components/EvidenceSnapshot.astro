---
const { snapshot } = Astro.props as {
  snapshot?: {
    claimSummary?: string;
    evidenceStrength?: string;
    whatWouldChangeMyMind?: string[];
    lastReviewedDate?: string;
  };
};

if (!snapshot) {
  // nothing to render
}
---
{snapshot ? (
  <section class="card evidence">
    <div class="header">Evidence Snapshot</div>

    {snapshot.claimSummary ? (
      <div class="block">
        <div class="label">Claim summary</div>
        <div>{snapshot.claimSummary}</div>
      </div>
    ) : null}

    {snapshot.evidenceStrength ? (
      <div class="block">
        <div class="label">Evidence strength</div>
        <div><span class="pill">{snapshot.evidenceStrength}</span></div>
      </div>
    ) : null}

    {snapshot.whatWouldChangeMyMind?.length ? (
      <div class="block">
        <div class="label">What would change my mind</div>
        <ul>
          {snapshot.whatWouldChangeMyMind.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </div>
    ) : null}

    {snapshot.lastReviewedDate ? (
      <div class="block">
        <div class="label">Last reviewed</div>
        <div>{new Date(snapshot.lastReviewedDate).toLocaleDateString()}</div>
      </div>
    ) : null}
  </section>
) : null}

<style>
  .evidence {
    background: #fbfbfc;
  }
  .header {
    font-weight: 900;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .block { margin-top: 12px; }
  .label { font-size: 12px; color: var(--muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
  ul { margin: 8px 0 0 18px; }
</style>
