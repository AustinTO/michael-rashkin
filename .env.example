# -----------------------------
# Shared Sanity settings
# -----------------------------
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Optional: only needed if your dataset is private or you want to fetch drafts.
# IMPORTANT: Keep this server-side only (do NOT prefix with PUBLIC_).
SANITY_READ_TOKEN=

# -----------------------------
# Astro (public) settings
# -----------------------------
# Used for canonical URLs / OpenGraph. Example: https://michaelrashkin.com
PUBLIC_SITE_URL=http://localhost:4321

# Newsletter + Contact form actions (optional)
# Example (ConvertKit): https://app.convertkit.com/forms/XXXX/subscriptions
PUBLIC_NEWSLETTER_FORM_ACTION=
# Example (Basin/Formspree/etc): https://usebasin.com/f/xxxxx
PUBLIC_CONTACT_FORM_ACTION=

# -----------------------------
# Sanity Studio settings (optional overrides)
# -----------------------------
# Leave these unset unless Studio should use a different project/dataset/version.
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=
# SANITY_STUDIO_API_VERSION=
